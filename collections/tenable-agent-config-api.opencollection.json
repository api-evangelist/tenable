{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About Agent Config API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Agent Config",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get agent configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/scanners/null/agents/config"
          },
          "docs": "Returns the global configuration settings for agents. These settings control auto-unlinking behavior, software update enablement, and the number of agents allowed to update simultaneously.<div class=\"perms-callout\">Requires the Scan Manager [40] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Update agent configuration",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://www.tenable.com/downloads/api/v2/scanners/null/agents/config",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the global agent configuration. <div class=\"perms-callout\">Requires the Scan Manager [40] user role. See [Roles](doc:roles).</div>"
        }
      ]
    }
  ],
  "bundled": true
}