{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About Cloud statistics API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Cloud statistics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get user info needed to send cloud statistics.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/cloud-statistics",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ]
          },
          "docs": "Required license type: ioe"
        }
      ]
    }
  ],
  "bundled": true
}