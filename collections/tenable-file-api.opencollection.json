{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About File API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "File",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Upload file",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.tenable.com/downloads/api/v2/file/upload",
            "params": [
              {
                "name": "no_enc",
                "value": "",
                "type": "query",
                "description": "Send value of `1` when uploading an encrypted file."
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "Filedata",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Uploads a file.<div class=\"perms-callout\">Requires the Basic [16] user role. See [Roles](doc:roles).</div>"
        }
      ]
    }
  ],
  "bundled": true
}