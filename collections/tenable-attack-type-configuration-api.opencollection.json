{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About Attack type configuration API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Attack type configuration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the attack type configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/attack-type-configuration",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ]
          },
          "docs": "Required license type: ioa, ioaPreview"
        },
        {
          "info": {
            "name": "Update the attack type configuration",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://www.tenable.com/downloads/api/v2/api/attack-type-configuration",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Required license type: ioa, ioaPreview"
        }
      ]
    }
  ],
  "bundled": true
}