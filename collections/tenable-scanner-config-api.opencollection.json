{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About Scanner Config API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Scanner Config",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get scanner configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/scanners/config"
          },
          "docs": "Returns the global scanner configuration settings, including concurrent update limits. <div class=\"perms-callout\">Requires the Scan Manager [40] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Update scanner configuration",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://www.tenable.com/downloads/api/v2/scanners/config",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the global scanner configuration settings. <div class=\"perms-callout\">Requires the Scan Manager [40] user role. See [Roles](doc:roles).</div>"
        }
      ]
    }
  ],
  "bundled": true
}