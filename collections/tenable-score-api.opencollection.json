{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About Score API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Score",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the directories score by profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/profiles/:profileId/scores",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "profileId",
                "value": "",
                "type": "path"
              },
              {
                "name": "directoryIds",
                "value": "",
                "type": "query"
              },
              {
                "name": "checkerIds",
                "value": "",
                "type": "query"
              },
              {
                "name": "reasonIds",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Required license type: ioe"
        }
      ]
    }
  ],
  "bundled": true
}