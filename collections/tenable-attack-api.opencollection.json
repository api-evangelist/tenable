{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About Attack API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Attack",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all attacks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/profiles/:profileId/attacks",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "profileId",
                "value": "",
                "type": "path"
              },
              {
                "name": "attackTypeIds",
                "value": "",
                "type": "query"
              },
              {
                "name": "dateEnd",
                "value": "",
                "type": "query"
              },
              {
                "name": "dateStart",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeClosed",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "order",
                "value": "",
                "type": "query"
              },
              {
                "name": "resourceType",
                "value": "",
                "type": "query"
              },
              {
                "name": "resourceValue",
                "value": "",
                "type": "query"
              },
              {
                "name": "search",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Required license type: ioa, ioaPreview"
        },
        {
          "info": {
            "name": "Get all attacks in CSV rows format",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/profiles/:profileId/attacks/export",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "profileId",
                "value": "",
                "type": "path"
              },
              {
                "name": "attackTypeIds",
                "value": "",
                "type": "query"
              },
              {
                "name": "dateEnd",
                "value": "",
                "type": "query"
              },
              {
                "name": "dateStart",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeClosed",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "order",
                "value": "",
                "type": "query"
              },
              {
                "name": "resourceType",
                "value": "",
                "type": "query"
              },
              {
                "name": "resourceValue",
                "value": "",
                "type": "query"
              },
              {
                "name": "search",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Required license type: ioa, ioaPreview"
        }
      ]
    }
  ],
  "bundled": true
}