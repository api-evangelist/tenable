{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About Agent Exclusions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Agent Exclusions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List agent exclusions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/scanners/null/agents/exclusions"
          },
          "docs": "Returns the list of current agent exclusions.<div class=\"perms-callout\">Requires the Scan Manager [40] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Create agent exclusion",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.tenable.com/downloads/api/v2/scanners/null/agents/exclusions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new agent exclusion.<div class=\"perms-callout\">Requires the Scan Manager [40] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Get agent exclusion details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/scanners/null/agents/exclusions/:exclusion_id",
            "params": [
              {
                "name": "exclusion_id",
                "value": "",
                "type": "path",
                "description": "The ID of the exclusion."
              }
            ]
          },
          "docs": "Returns details for the specified agent exclusion.<div class=\"perms-callout\">Requires the Scan Manager [40] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Update agent exclusion",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://www.tenable.com/downloads/api/v2/scanners/null/agents/exclusions/:exclusion_id",
            "params": [
              {
                "name": "exclusion_id",
                "value": "",
                "type": "path",
                "description": "The ID of the exclusion to edit."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an agent exclusion.<div class=\"perms-callout\">Requires the Scan Manager [40] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Delete agent exclusion",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://www.tenable.com/downloads/api/v2/scanners/null/agents/exclusions/:exclusion_id",
            "params": [
              {
                "name": "exclusion_id",
                "value": "",
                "type": "path",
                "description": "The ID of the exclusion to delete."
              }
            ]
          },
          "docs": "Deletes an agent exclusion.<div class=\"perms-callout\">Requires the Scan Manager [40] user role. See [Roles](doc:roles).</div>"
        }
      ]
    }
  ],
  "bundled": true
}