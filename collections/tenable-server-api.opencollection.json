{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About Server API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Server",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get server status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/server/status"
          },
          "docs": "Gets the server status.<div class=\"perms-callout\">Requires the Basic [16] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "List server properties",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/server/properties"
          },
          "docs": "Lists the server version and other properties.<div class=\"perms-callout\">Requires the Basic [16] user role. See [Roles](doc:roles).</div>"
        }
      ]
    }
  ],
  "bundled": true
}