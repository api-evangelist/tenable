{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About Reason API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reason",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve all reason instances.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/reasons",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ]
          },
          "docs": "Required license type: ioe"
        },
        {
          "info": {
            "name": "Get reason instance by id.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/reasons/:id",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Required license type: ioe"
        },
        {
          "info": {
            "name": "Retrieve all reason instances that have deviances for a specific profile and checker.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/profiles/:profileId/checkers/:checkerId/reasons",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "profileId",
                "value": "",
                "type": "path"
              },
              {
                "name": "checkerId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Required license type: ioe"
        },
        {
          "info": {
            "name": "Retrieve all reason instances for which we have deviances for a specific profile, directory and event.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/profiles/:profileId/infrastructures/:infrastructureId/directories/:directoryId/events/:eventId/reasons",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "profileId",
                "value": "",
                "type": "path"
              },
              {
                "name": "infrastructureId",
                "value": "",
                "type": "path"
              },
              {
                "name": "directoryId",
                "value": "",
                "type": "path"
              },
              {
                "name": "eventId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Required license type: ioe"
        }
      ]
    }
  ],
  "bundled": true
}