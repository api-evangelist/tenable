{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About Category API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Category",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve all category instances.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/categories",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ]
          },
          "docs": "Required license type: ioa, ioaPreview, ioe"
        },
        {
          "info": {
            "name": "Get category instance by id.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/categories/:id",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Required license type: ioa, ioaPreview, ioe"
        }
      ]
    }
  ],
  "bundled": true
}