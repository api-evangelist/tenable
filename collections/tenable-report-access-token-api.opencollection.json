{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About Report access token API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Report access token",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Returns the authentication token required to pull data from Tenable Cloud",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/report-access-token",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ]
          },
          "docs": "Required license type: ioa, ioaPreview, ioe"
        },
        {
          "info": {
            "name": "Updates the authentication token required to pull data from Tenable Cloud",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.tenable.com/downloads/api/v2/api/report-access-token/refresh",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ]
          },
          "docs": "Required license type: ioa, ioaPreview, ioe"
        }
      ]
    }
  ],
  "bundled": true
}