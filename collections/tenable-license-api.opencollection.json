{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About License API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "License",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get license singleton.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/license",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ]
          },
          "docs": "Required license type: none"
        },
        {
          "info": {
            "name": "Create new license singleton",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.tenable.com/downloads/api/v2/api/license",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Required license type: none"
        },
        {
          "info": {
            "name": "Get product association in the License",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/license/product-association"
          },
          "docs": "Required license type: none"
        },
        {
          "info": {
            "name": "Get license details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/mssp/license"
          },
          "docs": "Returns license details for the account associated with the user's API credentials. <div class=\"perms-callout\">Requires the Basic [16] user role. See [Roles](doc:roles).</div>"
        }
      ]
    }
  ],
  "bundled": true
}