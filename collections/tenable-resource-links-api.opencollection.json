{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About Resource Links API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Resource Links",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Bulk add resource links",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.tenable.com/downloads/api/v2/mssp/resourcelink/addBulk",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds or updates resource links for multiple customer accounts. <div class=\"perms-callout\">Requires the Basic [16] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "List resource links",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/mssp/resourcelink/account/:account_uuid",
            "params": [
              {
                "name": "account_uuid",
                "value": "",
                "type": "path",
                "description": "The UUID of the customer account you want to retrieve resource links for."
              }
            ]
          },
          "docs": "Returns the resource links for the specified account. <div class=\"perms-callout\">Requires the Basic [16] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Add resource links",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.tenable.com/downloads/api/v2/mssp/resourcelink/account/:account_uuid",
            "params": [
              {
                "name": "account_uuid",
                "value": "",
                "type": "path",
                "description": "The UUID of the customer account you want to add resource links for."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds or updates resource links for the specified customer account. <div class=\"perms-callout\">Requires the Basic [16] user role. See [Roles](doc:roles).</div>"
        }
      ]
    }
  ],
  "bundled": true
}