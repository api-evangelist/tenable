{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About AD object API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "AD object",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Return the last state of every ad-object at the provided timestampBy default, the timestamp is now. Objects out of scope are included",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/ad-objects",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ]
          },
          "docs": "Required license type: ioe, ioaPreview, ioa"
        },
        {
          "info": {
            "name": "Get ad-object instance by id.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/directories/:directoryId/ad-objects/:id",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "directoryId",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Required license type: ioe, ioaPreview, ioa"
        },
        {
          "info": {
            "name": "Get ad-object instance by id.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/infrastructures/:infrastructureId/directories/:directoryId/ad-objects/:id",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "directoryId",
                "value": "",
                "type": "path"
              },
              {
                "name": "infrastructureId",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Required license type: ioe, ioaPreview, ioa"
        },
        {
          "info": {
            "name": "Retrieve an AD object by id that have deviances for a specific profile and checker",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/profiles/:profileId/checkers/:checkerId/ad-objects/:id",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "profileId",
                "value": "",
                "type": "path"
              },
              {
                "name": "checkerId",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "showIgnored",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Required license type: ioe"
        },
        {
          "info": {
            "name": "Get one ad-object by event and by id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/infrastructures/:infrastructureId/directories/:directoryId/events/:eventId/ad-objects/:id",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "directoryId",
                "value": "",
                "type": "path"
              },
              {
                "name": "infrastructureId",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "eventId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Required license type: ioe, ioaPreview, ioa"
        },
        {
          "info": {
            "name": "Get one ad-object changes between a given event and the event which precedes it",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/infrastructures/:infrastructureId/directories/:directoryId/events/:eventId/ad-objects/:id/changes",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "infrastructureId",
                "value": "",
                "type": "path"
              },
              {
                "name": "directoryId",
                "value": "",
                "type": "path"
              },
              {
                "name": "eventId",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "wantedValues",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Required license type: ioe, ioaPreview, ioa"
        },
        {
          "info": {
            "name": "Search all AD objects having deviances by profile by checker",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.tenable.com/downloads/api/v2/api/profiles/:profileId/checkers/:checkerId/ad-objects/search",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "profileId",
                "value": "",
                "type": "path"
              },
              {
                "name": "checkerId",
                "value": "",
                "type": "path"
              },
              {
                "name": "perPage",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Required license type: ioe"
        }
      ]
    }
  ],
  "bundled": true
}