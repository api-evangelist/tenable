            "description": {
              "content": "Generates authorization keys for the specified child container. An `access_key` and a `secret_key` is included in the response. <div class=\"perms-callout\">Requires the Administrator [64] user role. See [Roles](doc:roles).</div>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "mssp",
                "accounts",
                "mssp-child-keys"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
