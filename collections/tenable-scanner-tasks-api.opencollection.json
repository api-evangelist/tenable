{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About Scanner Tasks API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Scanner Tasks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Send instructions to scanner",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.tenable.com/downloads/api/v2/scanners/:scanner_uuid/directives",
            "params": [
              {
                "name": "scanner_uuid",
                "value": "",
                "type": "path",
                "description": "The UUID of the scanner."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create instructions for a single scanner to perform.<div class=\"perms-callout\">Requires the Scan Manager [40] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Send instructions to multiple scanners",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.tenable.com/downloads/api/v2/scanners/bulk/directives",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create instructions for multiple scanners to perform. <div class=\"perms-callout\">Requires the Scan Manager [40] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Allow control of running scans",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.tenable.com/downloads/api/v2/scanners/:scanner_id/scans/:scan_uuid/control",
            "params": [
              {
                "name": "scanner_id",
                "value": "",
                "type": "path",
                "description": "The ID of the scanner."
              },
              {
                "name": "scan_uuid",
                "value": "",
                "type": "path",
                "description": "The UUID of the scan."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Allows control of scans that are currently running on a scanner.<div class=\"perms-callout\">Requires the Scan Manager [40] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Toggle scanner link state",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://www.tenable.com/downloads/api/v2/scanners/:scanner_id/link",
            "params": [
              {
                "name": "scanner_id",
                "value": "",
                "type": "path",
                "description": "The ID of the scanner."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Enables or disables the link state of the scanner identified by `scanner_id`.<div class=\"perms-callout\">Requires the Scan Manager [40] user role. See [Roles](doc:roles).</div>"
        }
      ]
    }
  ],
  "bundled": true
}