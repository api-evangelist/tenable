        {
          "id": "50339c0d-3d56-4790-9258-b1ed534a4114",
          "name": "Update allowed IP addresses",
          "request": {
            "name": "Update allowed IP addresses",
            "description": {
              "content": "Adds IP addresses or updates the existing list of IP addresses allowed to access the Tenable Vulnerability Management API.\n\n**Caution:** Unless your network assignments are restricted to only IPv4 addresses or only IPv6 addresses, you must specify allowed ranges for both IPv4 and IPv6 in order to avoid blocking some API traffic. It is not always predictable whether a client will connect via IPv4 or IPv6. <div class=\"perms-callout\">Requires the Administrator [64] user role. See [Roles](doc:roles).</div>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "access-control",
                "v1",
                "api-security-settings"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"allowed_ipv4_addresses\": \"<string>\",\n  \"allowed_ipv6_addresses\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
