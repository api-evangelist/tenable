{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About Access Control (Groups) API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Access Control (Groups)",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/groups"
          },
          "docs": "Lists all user groups for your container.<div class=\"perms-callout\">Requires the Basic [16] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Create group",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.tenable.com/downloads/api/v2/groups",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a user group.<div class=\"perms-callout\">Requires the Administrator [64] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Update group",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://www.tenable.com/downloads/api/v2/groups/:group_uuid",
            "params": [
              {
                "name": "group_uuid",
                "value": "",
                "type": "path",
                "description": "Specifies the unique identifier (UUID) or integer ID of the group."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the specified user group.<div class=\"perms-callout\">Requires the Administrator [64] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Delete group",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://www.tenable.com/downloads/api/v2/groups/:group_uuid",
            "params": [
              {
                "name": "group_uuid",
                "value": "",
                "type": "path",
                "description": "Specifies the unique identifier (UUID) or integer ID of the group."
              }
            ]
          },
          "docs": "Deletes the specified user group. The group must have no users before it can be deleted.<div class=\"perms-callout\">Requires the Administrator [64] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "List users in group",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/groups/:group_uuid/users",
            "params": [
              {
                "name": "group_uuid",
                "value": "",
                "type": "path",
                "description": "Specifies the unique identifier (UUID) or integer ID of the group."
              }
            ]
          },
          "docs": "Lists the users in the specified group.<div class=\"perms-callout\">Requires the Administrator [64] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Add user to group",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.tenable.com/downloads/api/v2/groups/:group_uuid/users/:user_uuid",
            "params": [
              {
                "name": "group_uuid",
                "value": "",
                "type": "path",
                "description": "Specifies the unique identifier (UUID) or integer ID of the group."
              },
              {
                "name": "user_uuid",
                "value": "",
                "type": "path",
                "description": "Specifies the unique identifier (UUID) or integer ID of the user."
              }
            ]
          },
          "docs": "Adds a user to the specified group.<div class=\"perms-callout\">Requires the Administrator [64] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Remove user from group",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://www.tenable.com/downloads/api/v2/groups/:group_uuid/users/:user_uuid",
            "params": [
              {
                "name": "group_uuid",
                "value": "",
                "type": "path",
                "description": "Specifies the unique identifier (UUID) or integer ID of the group."
              },
              {
                "name": "user_uuid",
                "value": "",
                "type": "path",
                "description": "Specifies the unique identifier (UUID) or integer ID of the user."
              }
            ]
          },
          "docs": "Removes a user from the specified group.<div class=\"perms-callout\">Requires the Administrator [64] user role. See [Roles](doc:roles).</div>"
        }
      ]
    }
  ],
  "bundled": true
}