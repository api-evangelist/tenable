{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About Widget API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Widget",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all widgets by dashboard id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/dashboards/:dashboardId/widgets",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "dashboardId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Required license type: ioe, ioaPreview, ioa"
        },
        {
          "info": {
            "name": "Create a new widget in dashboard by dashboard id",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.tenable.com/downloads/api/v2/api/dashboards/:dashboardId/widgets",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "dashboardId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Required license type: ioe, ioaPreview, ioa"
        },
        {
          "info": {
            "name": "Get widget instance by id.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/dashboards/:dashboardId/widgets/:id",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "dashboardId",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Required license type: ioe, ioaPreview, ioa"
        },
        {
          "info": {
            "name": "Update widget instance.",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://www.tenable.com/downloads/api/v2/api/dashboards/:dashboardId/widgets/:id",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "dashboardId",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Required license type: ioe, ioaPreview, ioa"
        },
        {
          "info": {
            "name": "Delete widget instance.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://www.tenable.com/downloads/api/v2/api/dashboards/:dashboardId/widgets/:id",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "dashboardId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Required license type: ioe, ioaPreview, ioa"
        },
        {
          "info": {
            "name": "Get a widget's options by id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/dashboards/:dashboardId/widgets/:id/options",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "dashboardId",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Required license type: ioe, ioaPreview, ioa"
        },
        {
          "info": {
            "name": "Define widget's options by id",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://www.tenable.com/downloads/api/v2/api/dashboards/:dashboardId/widgets/:id/options",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "dashboardId",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Required license type: ioe, ioaPreview, ioa"
        }
      ]
    }
  ],
  "bundled": true
}