{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About Domains API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Domains",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List domains",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/mssp/domains"
          },
          "docs": "Returns a list of all child containers and their domains. <div class=\"perms-callout\">Requires the Basic [16] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Add domain",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.tenable.com/downloads/api/v2/mssp/domains",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds a new domain to the specified container. <div class=\"perms-callout\">Requires the Administrator [64] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Get domain details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/mssp/domains/account/:account_uuid",
            "params": [
              {
                "name": "account_uuid",
                "value": "",
                "type": "path",
                "description": "The UUID of the customer account you want to retrieve domains for."
              }
            ]
          },
          "docs": "Returns a list of domains and their details for the specified account UUID. <div class=\"perms-callout\">Requires the Basic [16] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Update domain",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://www.tenable.com/downloads/api/v2/mssp/domains/account/:account_uuid",
            "params": [
              {
                "name": "account_uuid",
                "value": "",
                "type": "path",
                "description": "The UUID of the customer account you want to update a domain for."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a domain associated with the specified account UUID. <div class=\"perms-callout\">Requires the Administrator [64] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Send activation code",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.tenable.com/downloads/api/v2/mssp/domains/verifyDomain",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sends a verification code to add a domain to a container. <div class=\"perms-callout\">Requires the Administrator [64] user role. See [Roles](doc:roles).</div>"
        }
      ]
    }
  ],
  "bundled": true
}