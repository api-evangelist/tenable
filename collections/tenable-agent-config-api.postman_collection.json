          "name": "Get agent configuration",
          "request": {
            "name": "Get agent configuration",
            "description": {
              "content": "Returns the global configuration settings for agents. These settings control auto-unlinking behavior, software update enablement, and the number of agents allowed to update simultaneously.<div class=\"perms-callout\">Requires the Scan Manager [40] user role. See [Roles](doc:roles).</div>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "scanners",
                "null",
                "agents",
                "config"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET"
          },
