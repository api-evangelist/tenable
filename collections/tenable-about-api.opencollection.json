{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "About",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get about singleton.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/about"
          },
          "docs": "Required license type: none"
        }
      ]
    }
  ],
  "bundled": true
}