{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About Account Groups API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List account groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/mssp/accountGroup"
          },
          "docs": "Returns a list of account groups. <div class=\"perms-callout\">Requires BASIC [16] user permissions. See [Permissions](doc:permissions).</div>"
        },
        {
          "info": {
            "name": "Create account group",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.tenable.com/downloads/api/v2/mssp/accountGroup",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new account group. <div class=\"perms-callout\">Requires ADMINISTRATOR [64] user permissions. See [Permissions](doc:permissions).</div>"
        },
        {
          "info": {
            "name": "Get account group details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/mssp/accountGroup/:account_group_uuid",
            "params": [
              {
                "name": "account_group_uuid",
                "value": "",
                "type": "path",
                "description": "The UUID of the account group to retrieve details for."
              }
            ]
          },
          "docs": "Returns the details for the specified account group. <div class=\"perms-callout\">Requires BASIC [16] user permissions. See [Permissions](doc:permissions).</div>"
        },
        {
          "info": {
            "name": "Update account group",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://www.tenable.com/downloads/api/v2/mssp/accountGroup/:account_group_uuid",
            "params": [
              {
                "name": "account_group_uuid",
                "value": "",
                "type": "path",
                "description": "The UUID of the account group to update."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the specified account group. <div class=\"perms-callout\">Requires ADMINISTRATOR [64] user permissions. See [Permissions](doc:permissions).</div>"
        },
        {
          "info": {
            "name": "Delete account group",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://www.tenable.com/downloads/api/v2/mssp/accountGroup/:account_group_uuid",
            "params": [
              {
                "name": "account_group_uuid",
                "value": "",
                "type": "path",
                "description": "The UUID of the account group to delete."
              }
            ]
          },
          "docs": "Deletes the specified account group in the Tenable MSSP Portal. <div class=\"perms-callout\">Requires ADMINISTRATOR [64] user permissions. See [Permissions](doc:permissions).</div>"
        }
      ]
    }
  ],
  "bundled": true
}