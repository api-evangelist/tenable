{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About Logos API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Logos",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List logos",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/mssp/logos"
          },
          "docs": "Returns a list of logos you have uploaded to the Tenable MSSP Portal. <div class=\"perms-callout\">Requires the Basic [16] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Add logo",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.tenable.com/downloads/api/v2/mssp/logos",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "logo",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "name",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Adds a logo to the Tenable MSSP Portal. After you add a logo to the Tenable MSSP Portal, use the [PUT /mssp/accounts/logos](ref:io-mssp-logos-assign) endpoint to assign the logo to a customer account.<div class=\"perms-callout\">Requires the Administrator [64] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Get logo details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/mssp/logos/:logo_uuid",
            "params": [
              {
                "name": "logo_uuid",
                "value": "",
                "type": "path",
                "description": "The UUID of the logo for which you want to view details."
              }
            ]
          },
          "docs": "Returns details for the specified logo in the Tenable MSSP Portal. <div class=\"perms-callout\">Requires the Administrator [64] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Update logo",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://www.tenable.com/downloads/api/v2/mssp/logos/:logo_uuid",
            "params": [
              {
                "name": "logo_uuid",
                "value": "",
                "type": "path",
                "description": "The UUID of the logo to update."
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "logo",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "name",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Updates a logo in the Tenable MSSP Portal. This update overwrites the existing logo.<div class=\"perms-callout\">Requires the Administrator [64] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Delete logo",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://www.tenable.com/downloads/api/v2/mssp/logos/:logo_uuid",
            "params": [
              {
                "name": "logo_uuid",
                "value": "",
                "type": "path",
                "description": "The UUID of the logo to delete."
              }
            ]
          },
          "docs": "Deletes the specified logo in the Tenable MSSP Portal. <div class=\"perms-callout\">Requires the Administrator [64] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Assign logo",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://www.tenable.com/downloads/api/v2/mssp/accounts/logos",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Assigns a logo to one or more customer accounts in the Tenable MSSP Portal. <div class=\"perms-callout\">Requires the Basic [16] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Download logo (PNG)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/mssp/logos/:logo_uuid/logo.png",
            "params": [
              {
                "name": "logo_uuid",
                "value": "",
                "type": "path",
                "description": "The UUID of the logo to download."
              }
            ]
          },
          "docs": "Returns a logo file in PNG format. <div class=\"perms-callout\">Requires the Administrator [64] user role. See [Roles](doc:roles).</div>"
        },
        {
          "info": {
            "name": "Download logo (Base64)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/mssp/logos/:logo_uuid/logo.base64",
            "params": [
              {
                "name": "logo_uuid",
                "value": "",
                "type": "path",
                "description": "The UUID of the logo to download."
              }
            ]
          },
          "docs": "Returns a logo file in Base64 format. <div class=\"perms-callout\">Requires the Administrator [64] user role. See [Roles](doc:roles).</div>"
        }
      ]
    }
  ],
  "bundled": true
}