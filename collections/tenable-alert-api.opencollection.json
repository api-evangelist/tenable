{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About Alert API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Alert",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get alert instance by id.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/alerts/:id",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Required license type: ioe, ioaPreview, ioa"
        },
        {
          "info": {
            "name": "Update alert instance.",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://www.tenable.com/downloads/api/v2/api/alerts/:id",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Required license type: ioe, ioaPreview, ioa"
        },
        {
          "info": {
            "name": "Retrieve all alert instances.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/profiles/:profileId/alerts",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "profileId",
                "value": "",
                "type": "path"
              },
              {
                "name": "archived",
                "value": "",
                "type": "query"
              },
              {
                "name": "read",
                "value": "",
                "type": "query"
              },
              {
                "name": "perPage",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Required license type: ioe, ioaPreview, ioa"
        },
        {
          "info": {
            "name": "Update alerts for one profile",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://www.tenable.com/downloads/api/v2/api/profiles/:profileId/alerts",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "profileId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Required license type: ioe, ioaPreview, ioa"
        }
      ]
    }
  ],
  "bundled": true
}