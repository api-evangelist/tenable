{
  "opencollection": "1.0.0",
  "info": {
    "name": "Downloads About Checker option API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Checker option",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all the checker options related to a profile and checker.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/api/profiles/:profileId/checkers/:checkerId/checker-options",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "profileId",
                "value": "",
                "type": "path"
              },
              {
                "name": "checkerId",
                "value": "",
                "type": "path"
              },
              {
                "name": "staged",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Required license type: ioe"
        },
        {
          "info": {
            "name": "Create checker options related to a profile and checker.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.tenable.com/downloads/api/v2/api/profiles/:profileId/checkers/:checkerId/checker-options",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "profileId",
                "value": "",
                "type": "path"
              },
              {
                "name": "checkerId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Required license type: ioe"
        }
      ]
    }
  ],
  "bundled": true
}