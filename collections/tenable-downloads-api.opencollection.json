{
  "opencollection": "1.0.0",
  "info": {
    "name": "About Downloads API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Downloads",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List product pages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/pages"
          },
          "docs": "Returns a list of product pages."
        },
        {
          "info": {
            "name": "List downloadable files for a product",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/pages/:slug",
            "params": [
              {
                "name": "slug",
                "value": "",
                "type": "path",
                "description": "The product page slug; for example, `nessus`."
              }
            ]
          },
          "docs": "Returns a JSON hash of all download files for a given product page."
        },
        {
          "info": {
            "name": "Download a file",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.tenable.com/downloads/api/v2/pages/:slug/files/:file",
            "params": [
              {
                "name": "slug",
                "value": "",
                "type": "path",
                "description": "The product page slug; for example, `nessus`."
              },
              {
                "name": "file",
                "value": "",
                "type": "path",
                "description": "The name of the file; for example, `Nessus-latest-x64.msi`."
              }
            ]
          },
          "docs": "Downloads a requested file.\n\n**Note:** Some files require an authentication token to download."
        }
      ]
    }
  ],
  "bundled": true
}